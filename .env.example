# Copy this file to .env and fill in your real key. .env is gitignored —
# it is never committed. megachud.config.Settings.load() picks this up
# automatically (a real ANTHROPIC_API_KEY environment variable always
# takes precedence over this file if both are set).
#
# With no key configured (no .env, no env var), every LLM-backed
# component in this project falls back to its existing deterministic
# implementation — the app runs identically to before this capability
# existed.

ANTHROPIC_API_KEY=
